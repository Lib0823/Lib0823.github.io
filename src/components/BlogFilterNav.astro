---
import type { CollectionEntry } from 'astro:content';
import { slugify } from '../lib/taxonomy';

interface Props {
  posts: CollectionEntry<'blog'>[];
  activeCategorySlug?: string;
  activeTagSlug?: string;
}

const { posts, activeCategorySlug, activeTagSlug } = Astro.props;

const categoryOrder = ['Backend', 'Language', 'Database', 'Infrastructure', 'AI'];

const categoryIcons: Record<string, string> = {
  Backend:
    '<rect x="3" y="4" width="18" height="6" rx="1.5" /><rect x="3" y="14" width="18" height="6" rx="1.5" /><path d="M7 7h.01M7 17h.01" />',
  Language: '<polyline points="8 6 2 12 8 18" /><polyline points="16 6 22 12 16 18" />',
  Database:
    '<ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" /><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />',
  Infrastructure:
    '<polygon points="12 3 3 8 12 13 21 8 12 3" /><polyline points="3 16 12 21 21 16" /><polyline points="3 12 12 17 21 12" />',
  AI: '<path d="M12 3v4M12 17v4M5 12h4M15 12h4M7.5 7.5l2 2M14.5 14.5l2 2M16.5 7.5l-2 2M9.5 14.5l-2 2" />',
};

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}

// Scope the tag cloud to the active category (if any) so e.g. Backend only
// surfaces tags that actually appear on Backend posts, not the whole blog.
const tagSourcePosts = activeCategorySlug
  ? posts.filter((post) => slugify(post.data.category) === activeCategorySlug)
  : posts;

const tagCounts = new Map<string, number>();
for (const post of tagSourcePosts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const allTags = [...tagCounts.entries()]
  .filter(([tag]) => slugify(tag))
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

// Only show the top tags by default -- a full tag cloud gets noisy fast.
// The tag currently being viewed always stays visible even if it falls outside it.
const TOP_TAG_COUNT = 10;
const topTags = allTags.slice(0, TOP_TAG_COUNT);
const activeTag = allTags.find(([tag]) => slugify(tag) === activeTagSlug);
const tags = activeTag && !topTags.includes(activeTag) ? [...topTags, activeTag] : topTags;
const hasMoreTags = allTags.length > tags.length;
---

<div class="blog-filters">
  <div class="filter-row">
    <a class={`filter-btn ${!activeCategorySlug ? 'active' : ''}`} href="/blog/" data-category-label="__all__">
      All <span class="count">{posts.length}</span>
    </a>
    {categoryOrder
      .filter((category) => categoryCounts.has(category))
      .map((category) => (
        <a
          class={`filter-btn ${activeCategorySlug === slugify(category) ? 'active' : ''}`}
          href={`/blog/category/${slugify(category)}/`}
          data-category-label={category}
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={categoryIcons[category]} />
          {category} <span class="count">{categoryCounts.get(category)}</span>
        </a>
      ))}
  </div>

  {tags.length > 0 && (
    <div class="tag-cloud">
      {tags.map(([tag, count]) => (
        <a class={`tag-pill ${activeTagSlug === slugify(tag) ? 'active' : ''}`} href={`/blog/tag/${slugify(tag)}/`}>
          #{tag} <span class="count">{count}</span>
        </a>
      ))}
      {hasMoreTags && (
        <a class="tag-pill tag-pill-more" href="/blog/tag/">
          태그 더보기 →
        </a>
      )}
    </div>
  )}
</div>

<style>
  .blog-filters {
    margin-top: 32px;
    margin-bottom: 32px;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: all 0.15s ease;
  }

  .filter-btn svg {
    flex-shrink: 0;
  }

  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filter-btn.active {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .filter-btn .count {
    opacity: 0.7;
    font-size: 0.85em;
  }

  .filter-btn.filter-empty {
    opacity: 0.4;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .tag-pill {
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--text-muted);
    background: var(--bg-inset);
    transition: all 0.15s ease;
  }

  .tag-pill:hover {
    color: var(--accent);
  }

  .tag-pill.active {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }

  .tag-pill .count {
    opacity: 0.7;
  }

  .tag-pill-more {
    background: none;
    border: 1px dashed var(--border);
    color: var(--text-muted);
    font-weight: 600;
  }

  .tag-pill-more:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
