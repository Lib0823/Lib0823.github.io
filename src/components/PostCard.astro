---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' });
---

<a class="card post-card" href={`/blog/${post.id}/`}>
  <span class="badge">{post.data.category}</span>
  <h2>{post.data.title}</h2>
  <p class="text-muted">{post.data.description}</p>
  <div class="tag-row post-tags">
    {post.data.tags.map((tag) => (
      <span class="badge badge-outline">{tag}</span>
    ))}
  </div>
  <time class="text-muted" datetime={post.data.date.toISOString()}>
    {dateFormatter.format(post.data.date)}
  </time>
</a>

<style is:global>
  .post-card h2 {
    font-size: 1.05rem;
    margin-top: 12px;
  }

  .post-card p {
    margin-top: 8px;
    font-size: 0.92rem;
  }

  .post-tags {
    margin-top: 14px;
  }

  .post-card time {
    display: block;
    margin-top: 14px;
    font-size: 0.82rem;
  }
</style>
