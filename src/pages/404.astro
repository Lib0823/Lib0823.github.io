---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="페이지를 찾을 수 없습니다.">
  <section class="section not-found">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="not-found-title">페이지를 찾을 수 없습니다.</h1>
      <p class="text-muted not-found-lead">주소가 변경되었거나 존재하지 않는 페이지입니다.</p>
      <div class="not-found-actions">
        <a class="btn btn-primary" href="/">Home으로</a>
        <a class="btn" href="/blog/">Blog 보기</a>
        <a class="btn" href="/research/">Research 보기</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 50vh;
    display: flex;
    align-items: center;
  }

  .not-found-title {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin-top: 8px;
  }

  .not-found-lead {
    margin-top: 12px;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
