---
import type { GetStaticPathsOptions } from 'astro';
import { getCollection } from 'astro:content';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogFilterNav from '../../components/BlogFilterNav.astro';
import PostGrid from '../../components/PostGrid.astro';
import Pagination from '../../components/Pagination.astro';
import { PAGE_SIZE } from '../../lib/taxonomy';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return paginate(posts, { pageSize: PAGE_SIZE });
}

const { page } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
---

<BaseLayout title="Blog" description="Java 백엔드, 인프라, AI 관련 기술 기록.">
  <section class="section">
    <div class="container">
      <div class="kicker">
        <span class="section-icon">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
          </svg>
        </span>
        <p class="eyebrow">Blog</p>
      </div>
      <h1 class="page-title">기술 블로그</h1>
      <p class="text-muted page-lead">Backend, Language, Database, Infrastructure, AI 주제로 작성한 기술 기록입니다.</p>

      <PagefindConfig instance="blog-search" />
      <div class="search-box">
        <pagefind-searchbox instance="blog-search" placeholder="글 제목, 내용으로 검색"></pagefind-searchbox>
      </div>
      <pagefind-results instance="blog-search"></pagefind-results>

      <BlogFilterNav posts={allPosts} />

      <PostGrid posts={page.data} />

      <Pagination page={page} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-top: 8px;
  }

  .page-lead {
    margin-top: 12px;
    max-width: 640px;
  }

  .search-box {
    margin-top: 28px;
    max-width: 480px;
  }
</style>

<style is:global>
  .search-box,
  pagefind-results {
    --pf-text: var(--text);
    --pf-text-secondary: var(--text-muted);
    --pf-text-muted: var(--text-faint);
    --pf-background: var(--bg);
    --pf-border: var(--border);
    --pf-border-focus: var(--accent);
    --pf-hover: var(--bg-soft);
    --pf-mark: var(--accent);
    --pf-outline-focus: var(--accent);
    --pf-font: var(--font-sans);
    --pf-border-radius: var(--radius-sm);
    --pf-shadow-md: var(--shadow);
  }

  pagefind-results {
    display: block;
    margin-top: 12px;
  }
</style>
