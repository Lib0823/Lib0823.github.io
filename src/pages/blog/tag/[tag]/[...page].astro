---
import type { GetStaticPathsOptions } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BlogFilterNav from '../../../../components/BlogFilterNav.astro';
import PostGrid from '../../../../components/PostGrid.astro';
import Pagination from '../../../../components/Pagination.astro';
import { slugify, PAGE_SIZE } from '../../../../lib/taxonomy';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))].filter((tag) => slugify(tag));

  return tags.flatMap((tag) => {
    const filtered = posts.filter((post) => post.data.tags.includes(tag));
    return paginate(filtered, {
      params: { tag: slugify(tag) },
      props: { tagLabel: tag },
      pageSize: PAGE_SIZE,
    });
  });
}

const { page, tagLabel } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
---

<BaseLayout title={`#${tagLabel} · Blog`} description={`${tagLabel} 태그가 달린 기술 기록.`}>
  <section class="section">
    <div class="container">
      <a class="back-link text-muted" href="/blog/">← Blog</a>
      <div class="kicker">
        <span class="section-icon">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3H4a1 1 0 0 0-1 1v5.59a2 2 0 0 0 .59 1.41l9.58 9.59a2 2 0 0 0 2.82 0l4.6-4.6a2 2 0 0 0 0-2.82Z" />
            <circle cx="7.5" cy="7.5" r="1.5" />
          </svg>
        </span>
        <p class="eyebrow">Tag</p>
      </div>
      <h1 class="page-title">#{tagLabel}</h1>

      <BlogFilterNav posts={allPosts} activeTagSlug={slugify(tagLabel)} />

      <PostGrid posts={page.data} />

      <Pagination page={page} />
    </div>
  </section>
</BaseLayout>

<style>
  .back-link {
    display: block;
    font-size: 0.9rem;
    margin-bottom: 20px;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }
</style>
