---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { slugify } from '../../../lib/taxonomy';

const posts = await getCollection('blog', ({ data }) => !data.draft);

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()]
  .filter(([tag]) => slugify(tag))
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="전체 태그 · Blog" description="블로그에 사용된 모든 태그 목록입니다.">
  <section class="section">
    <div class="container">
      <a class="back-link text-muted" href="/blog/">← Blog</a>
      <p class="eyebrow">All Tags</p>
      <h1 class="page-title">전체 태그</h1>
      <p class="text-muted count-lead">총 {tags.length}개</p>

      <div class="tag-cloud">
        {tags.map(([tag, count]) => (
          <a class="tag-pill" href={`/blog/tag/${slugify(tag)}/`}>
            #{tag} <span class="count">{count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .back-link {
    display: block;
    font-size: 0.9rem;
    margin-bottom: 20px;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }

  .count-lead {
    margin-top: 8px;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .tag-pill {
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--text-muted);
    background: var(--bg-inset);
    transition: all 0.15s ease;
  }

  .tag-pill:hover {
    color: var(--accent);
  }

  .tag-pill .count {
    opacity: 0.7;
  }
</style>
