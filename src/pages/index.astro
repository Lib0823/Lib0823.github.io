---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import profilePhoto from '../assets/profile.jpg';
import { experience, education, techStack, featuredRepos } from '../data/profile';

const posts = await getCollection('blog', ({ data }) => !data.draft);

const curatedPostSlugs = ['claude-context-kit-plugin', 'database-rocksdb-rdb-memorydb', 'postgresql-connection-pooling-pgbouncer'];
const curatedPosts = curatedPostSlugs
  .map((slug) => posts.find((p) => p.id === slug))
  .filter((p) => p !== undefined);

const research = await getCollection('research');
const currentResearch = research
  .filter((r) => r.data.status === 'in-progress')
  .sort((a, b) => a.data.order - b.data.order);

const dateFormatter = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Inbeom Lee">
  <section class="hero section">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Backend Developer · Graduate Student</p>
        <h1>이인범, 안정적인 백엔드 시스템을 연구하고 만듭니다.</h1>
        <p class="hero-lead text-muted">
          대규모 로그 데이터를 처리하는 보안 솔루션에서 백엔드를 중심으로 프론트엔드까지
          아우르는 풀스택 개발을 하며, 성능 튜닝과 인프라 현대화를 함께 이끌고 있습니다. 데이터
          분석 기반 트레이딩 시스템을 사이드 프로젝트로 직접 설계·구현하고 있고, 대학원에서는
          신뢰도 기반 GNN 예측으로 MSA 연쇄 장애에 선제 대응하는 아키텍처를 연구하고 있습니다.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/research/">연구 살펴보기</a>
          <a class="btn" href="/blog/">블로그 읽기</a>
        </div>
      </div>
      <Image class="hero-photo" src={profilePhoto} alt="이인범 프로필 사진" width={280} height={350} />
    </div>
  </section>

  <section class="section section-border" id="about">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="kicker">
            <span class="section-icon">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c0-4 3.58-6 8-6s8 2 8 6" />
              </svg>
            </span>
            <p class="eyebrow">About</p>
          </div>
          <h2 class="section-title">소개</h2>
        </div>
      </div>
      <p class="about-lead text-muted">
        고등학교 때부터 컴퓨터에 관심을 갖고 쭉 개발자의 길을 걸어왔습니다. 지금은 대규모 로그
        데이터를 다루는 백엔드 시스템을 만들며, AI 도구를 적극 활용해 개발 생산성을 높이는 방법을
        고민하고 있습니다.
      </p>
      <div class="tag-row">
        <span class="badge badge-outline">Backend Developer</span>
        <span class="badge badge-outline">Sogang University AI·SW Graduate Student</span>
        <span class="badge badge-outline">백엔드 성능 튜닝 · 대규모 데이터 처리 최적화</span>
        <span class="badge badge-outline">AI 도구를 활용한 개발 생산성 향상에 관심</span>
      </div>
    </div>
  </section>

  <section class="section section-border" id="experience-education">
    <div class="container grid grid-2">
      <div>
        <div class="kicker">
          <span class="section-icon">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="7" width="18" height="13" rx="2" />
              <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
              <path d="M3 12h18" />
            </svg>
          </span>
          <p class="eyebrow">Experience</p>
        </div>
        <h2 class="section-title">경력</h2>
        <ul class="timeline-list">
          {experience.map((item) => (
            <li>
              <span class="timeline-title">{item.role}</span>
              <span class="text-muted">{item.company} · {item.period}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <div class="kicker">
          <span class="section-icon">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 9 12 4l10 5-10 5-10-5Z" />
              <path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5" />
            </svg>
          </span>
          <p class="eyebrow">Education</p>
        </div>
        <h2 class="section-title">학력</h2>
        <ul class="timeline-list">
          {education.map((item) => (
            <li>
              <span class="timeline-title">{item.school}</span>
              {item.detail && <span class="text-muted">{item.detail}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-border" id="tech-stack">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="kicker">
            <span class="section-icon">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="12 3 3 8 12 13 21 8 12 3" />
                <polyline points="3 16 12 21 21 16" />
                <polyline points="3 12 12 17 21 12" />
              </svg>
            </span>
            <p class="eyebrow">Tech Stack</p>
          </div>
          <h2 class="section-title">기술 스택</h2>
        </div>
      </div>
      <div class="grid tech-grid">
        {techStack.map((group) => (
          <div class="tech-group">
            <h3>{group.group}</h3>
            <div class="tag-row">
              {group.items.map((item) => (
                <span class="badge badge-outline">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-border" id="featured-repos">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="kicker">
            <span class="section-icon">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="8 6 2 12 8 18" />
                <polyline points="16 6 22 12 16 18" />
              </svg>
            </span>
            <p class="eyebrow">Featured Repositories</p>
          </div>
          <h2 class="section-title">대표 저장소</h2>
        </div>
      </div>
      <div class="grid grid-3">
        {featuredRepos.map((repo) => (
          <a class="card repo-card" href={repo.href} target="_blank" rel="noreferrer">
            <svg class="repo-icon" viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            <h3>{repo.name}</h3>
            <p class="text-muted">{repo.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-border" id="latest-posts">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="kicker">
            <span class="section-icon">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
              </svg>
            </span>
            <p class="eyebrow">Latest Blog Posts</p>
          </div>
          <h2 class="section-title">최근 작성한 글</h2>
        </div>
        <a class="btn" href="/blog/">전체 글 보기</a>
      </div>
      <div class="grid grid-3">
        {curatedPosts.map((post) => (
          <a class="card post-card" href={`/blog/${post.id}/`}>
            <span class="badge">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p class="text-muted">{post.data.description}</p>
            <time class="text-muted" datetime={post.data.date.toISOString()}>
              {dateFormatter.format(post.data.date)}
            </time>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-border" id="current-research">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="kicker">
            <span class="section-icon">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 3h6" />
                <path d="M10 3v6.5L4.5 19a1 1 0 0 0 .87 1.5h13.26a1 1 0 0 0 .87-1.5L14 9.5V3" />
              </svg>
            </span>
            <p class="eyebrow">Current Research</p>
          </div>
          <h2 class="section-title">진행 중인 연구</h2>
        </div>
        <a class="btn" href="/research/">연구 전체 보기</a>
      </div>
      <div class="grid grid-2">
        {currentResearch.map((project) => (
          <a class="card research-card" href={`/research/projects/${project.id}/`}>
            <span class="badge">{project.data.period}</span>
            <h3>{project.data.title}</h3>
            <p class="text-muted">{project.data.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-border" id="documents">
    <div class="container documents-inner">
      <div>
        <div class="kicker">
          <span class="section-icon">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
              <polyline points="14 2 14 8 20 8" />
              <path d="M9 13h6" />
              <path d="M9 17h6" />
            </svg>
          </span>
          <p class="eyebrow">Documents</p>
        </div>
        <h2 class="section-title">Resume &amp; Portfolio</h2>
        <p class="text-muted">PDF 파일로 정리한 이력서와 포트폴리오입니다.</p>
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/resume.pdf" target="_blank">
          <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
            <path d="M4 0a1.5 1.5 0 0 0-1.5 1.5v13A1.5 1.5 0 0 0 4 16h8a1.5 1.5 0 0 0 1.5-1.5V5.5L9 0H4Zm5 1 3.5 3.5H9.5A.5.5 0 0 1 9 4V1Z" />
          </svg>
          Resume (PDF)
        </a>
        <a class="btn" href="/portfolio.pdf" target="_blank">
          <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
            <path d="M4 0a1.5 1.5 0 0 0-1.5 1.5v13A1.5 1.5 0 0 0 4 16h8a1.5 1.5 0 0 0 1.5-1.5V5.5L9 0H4Zm5 1 3.5 3.5H9.5A.5.5 0 0 1 9 4V1Z" />
          </svg>
          Portfolio (PDF)
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -15%;
    width: min(520px, 55vw);
    height: min(520px, 55vw);
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 72%);
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: clamp(24px, 6vw, 56px);
    max-width: 1000px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(24px, 5vw, 64px);
  }

  .hero-text {
    max-width: 640px;
  }

  .hero-photo {
    flex-shrink: 0;
    width: 152px;
    height: 152px;
    object-fit: cover;
    border-radius: 999px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow), 0 0 0 6px var(--accent-soft);
  }

  @media (max-width: 760px) {
    .hero-inner {
      flex-direction: column-reverse;
      text-align: center;
    }

    .hero-text {
      max-width: none;
    }

    .hero-photo {
      width: 132px;
      height: 132px;
    }

    .hero-actions {
      justify-content: center;
    }
  }

  .hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-top: 12px;
  }

  .hero-lead {
    margin-top: 20px;
    font-size: 1.05rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .about-lead {
    max-width: 640px;
    font-size: 1rem;
    margin-bottom: 24px;
  }

  .timeline-list li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: 12px;
    border-top: 1px solid var(--border);
  }

  .timeline-list li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .timeline-title {
    font-weight: 600;
  }

  .tech-grid {
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  .tech-group h3 {
    font-size: 1rem;
    margin-bottom: 12px;
  }

  .repo-icon {
    color: var(--text-muted);
  }

  .repo-card h3,
  .post-card h3,
  .research-card h3 {
    font-size: 1.05rem;
    margin-top: 12px;
  }

  .post-card p,
  .research-card p {
    margin-top: 8px;
    font-size: 0.92rem;
  }

  .post-card time {
    display: block;
    margin-top: 14px;
    font-size: 0.82rem;
  }

  .documents-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
</style>
