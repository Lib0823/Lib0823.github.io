---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('project')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Project" description="직접 설계하고 운영한 개인 프로젝트와 트러블슈팅 기록.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Project</p>
      <h1 class="page-title">프로젝트</h1>
      <p class="text-muted page-lead">
        직접 설계하고 운영한 개인 프로젝트와, 그 과정에서 겪은 문제를 어떻게 진단하고 해결했는지
        기록합니다.
      </p>

      <div class="grid grid-2 project-grid">
        {projects.map((project) => (
          <a class="card project-card" href={`/project/${project.id}/`}>
            <div class="project-card-head">
              <span class="text-muted period">{project.data.period}</span>
            </div>
            <h2>{project.data.title}</h2>
            <p class="text-muted">{project.data.summary}</p>
            <div class="tag-row">
              {project.data.stack.map((tech) => (
                <span class="badge badge-outline">{tech}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-top: 8px;
  }

  .page-lead {
    margin-top: 12px;
    max-width: 680px;
    margin-bottom: 36px;
  }

  .project-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .period {
    font-size: 0.85rem;
  }

  .project-card h2 {
    font-size: 1.15rem;
    margin-top: 14px;
  }

  .project-card p {
    margin-top: 10px;
  }

  .project-card .tag-row {
    margin-top: 16px;
  }
</style>
